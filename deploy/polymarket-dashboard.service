[Unit]
Description=Polymarket live dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/polymarket-dashboard
Environment=NODE_ENV=production
Environment=PORT=8787
Environment=CACHE_MS=15000
ExecStart=/usr/bin/node /opt/polymarket-dashboard/server.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
